# One free API key supports Geoapify geocoding AND road routing.
# Create it at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=your_free_geoapify_key_here

# Local development settings
DJANGO_SECRET_KEY=change-me-for-any-public-deployment
DJANGO_DEBUG=True

# Change these only if a long route cannot find a feasible stop chain.
# More cities = more first-run geocoding calls / slower cold request.
MAX_STATION_CITIES=30
STATION_MAX_DETOUR_MILES=25
